{
  "name": "ts-game",
  "version": "1.0.0",
  "description": "Simple TypeScript project with canvas",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "preview": "vite preview",
    "server": "node --loader ts-node/esm --no-warnings server/gameServer.ts",
    "server:watch": "node --watch --loader ts-node/esm --no-warnings server/gameServer.ts",
    "start": "node server-dist/gameServer.js",
    "start:all": "npm run server:watch & npm run dev"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^5.0.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  },
  "dependencies": {
    "express": "^5.1.0",
    "phaser": "^3.90.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  }
}
